{
  "name": "ski-stream-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only VOLA SQLite to OBS WebSocket bridge",
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "start": "node src/cli.cjs",
    "test": "node --test test/*.test.cjs",
    "build:bundle": "esbuild src/cli.cjs --bundle --platform=node --target=node24 --format=cjs --outfile=build/bridge.cjs --external:bufferutil --external:utf-8-validate",
    "build:exe": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "check:publication": "node scripts/check-publication.cjs"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "postject": "1.0.0-alpha.6"
  }
}
